# Copy this file to .env and fill in real values for your environment.
# .env is gitignored -- never commit real secrets.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# True for local development ONLY. Must be False in any real deployment.
DEBUG=True

# Comma-separated list of hostnames this API is allowed to serve.
# Local dev default (127.0.0.1,localhost) works out of the box.
# In production, set this to your actual API domain, e.g.:
#   ALLOWED_HOSTS=devflow-api.onrender.com
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated list of frontend origins allowed to call this API.
# Local dev default covers the Vite dev server.
# In production, set this to your actual frontend domain, e.g.:
#   CORS_ALLOWED_ORIGINS=https://devflow.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. If unset, falls back to a local SQLite database (fine for dev).
# In production, set this to your Postgres connection string, e.g.:
#   DATABASE_URL=postgres://user:password@host:5432/devflow
DATABASE_URL=